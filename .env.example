# ==========================================
# Configurações do LattesScraper
# ==========================================

# 1. Scraping via Playwright (BrightData Browser API com resolução de CAPTCHA)
# Exemplo: wss://brd-customer-hl_XXXX:YYYY@brd.superproxy.io:9222
CDP_URL=

# 2. Extração via IA (OpenRouter ou compatível com OpenAI)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-medium-3

# 3. Limite de requisições concorrentes
CONCURRENCY_LIMIT=5
